---
// src/pages/index.astro
// This is your homepage. It replaces index.html.
// Edit content directly in the HTML below.
// To add/edit projects, update src/data/projects.ts — not this file.

import BaseLayout from "../layouts/BaseLayout.astro";
import ProjectCard from "../components/ProjectCard.astro";
import { allProjects } from "../data/projects";

// Status now determines which subsection a project lives in, not a badge on the card.
const current  = allProjects.filter((p) => p.status !== "complete");
const shipped  = allProjects.filter((p) => p.status === "complete");
const featured = shipped.filter((p) => p.featured);
const others   = shipped.filter((p) => !p.featured);
---

<BaseLayout title="Will Armsworthy">

  <!-- ── HERO ──────────────────────────────────────────────── -->
  <section id="home" class="hero">
    <div class="hero-inner">
      <span class="hero-ghost-num" aria-hidden="true">00</span>
      <p class="hero-eyebrow">Analyst @ insight2profit</p>
      <h1>Will Armsworthy</h1>
      <p class="hero-sub">Interested in databases, urban development, and all things sports.</p>
      <div class="hero-links">
        <a href="#projects" class="btn-primary">See my work</a>
        <a href="#contact" class="btn-ghost">Get in touch</a>
      </div>
    </div>
  </section>

  <!-- ── ABOUT ─────────────────────────────────────────────── -->
  <section id="about">
    <div class="container">
      <div class="editorial-grid">
        <div class="rail">
          <span class="section-index">01 <em>/</em> ABOUT</span>
          <img
            src="/assets/pictures/pweb2.JPG"
            alt="Will Armsworthy"
            class="about-photo"
          />
          <p class="about-caption">B.S. COMPUTER SCIENCE — NOTRE DAME '26</p>
        </div>
        <div class="about-content">
          <h2>About Me</h2>
          <p>
            What's up! I'm Will, currently working as a Business Analyst at Insight2Profit.
            I graduated in May 2026 from the University of Notre Dame with a degree in Computer Science.
            Based in Chicago, I've recently developed an interest in urban planning and development.
            I also love data organization and analytics, especially when I can apply this interest to the sports I follow.
            Feel free to take a look at some of my experience and things I've built, and don't hesitate to reach out if you'd like!
          </p>
          <!-- Add more paragraphs, a skills list, coursework, etc. here -->
        </div>
      </div>
    </div>
  </section>

  <!-- ── PROJECTS ──────────────────────────────────────────── -->
  <section id="projects">
    <div class="container">
      <div class="editorial-grid">
        <div class="rail">
          <span class="section-index">02 <em>/</em> PROJECTS</span>
          <p class="rail-stat">{shipped.length} SHIPPED</p>
        </div>
        <div>
          <h2>Projects</h2>

          <h3 class="section-sub">Currently Building</h3>
          {current.length > 0 ? (
            <div class="projects-grid">
              {current.map((project) => (
                <ProjectCard project={project} variant="featured" />
              ))}
            </div>
          ) : (
            <div class="empty-panel">
              <span>No active builds</span>
            </div>
          )}

          {featured.length > 0 && (
            <>
              <h3 class="section-sub" style="margin-top: 2.5rem;">Recent Projects</h3>
              <div class="projects-grid">
                {featured.map((project) => (
                  <ProjectCard project={project} variant="featured" />
                ))}
              </div>
            </>
          )}

          {others.length > 0 && (
            <>
              <h3 class="section-sub" style="margin-top: 2.5rem;">Older Projects</h3>
              <div class="project-rows">
                {others.map((project) => (
                  <ProjectCard project={project} variant="compact" />
                ))}
              </div>
            </>
          )}
        </div>
      </div>
    </div>
  </section>

  <!-- ── CONTACT ────────────────────────────────────────────── -->
  <section id="contact">
    <div class="container">
      <div class="editorial-grid">
        <div class="rail">
          <span class="section-index">03 <em>/</em> CONTACT</span>
          <p class="rail-stat">BASED IN CHICAGO, IL</p>
        </div>
        <div>
          <h2>Contact</h2>
          <div class="contact-rows">
            <div class="contact-row">
              <span class="contact-label">Email</span>
              <a href="mailto:armsworthy61@gmail.com">armsworthy61@gmail.com</a>
            </div>
            <div class="contact-row">
              <span class="contact-label">LinkedIn</span>
              <a href="https://www.linkedin.com/in/william-armsworthy-379136259" target="_blank" rel="noopener">
                william-armsworthy
              </a>
            </div>
            <div class="contact-row">
              <span class="contact-label">GitHub</span>
              <a href="https://github.com/willarms" target="_blank" rel="noopener">
                willarms
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

</BaseLayout>

<style>
  /* ── HERO ─────────────────────────────────────────────────── */
  .hero {
    min-height: 70vh;
    display: flex;
    align-items: center;
    background: var(--color-surface);
    border-bottom: 1px solid var(--color-border);
    overflow: hidden;
  }

  .hero-inner {
    position: relative;
    max-width: 760px;
    margin-left: max(var(--gutter), calc((100vw - var(--container-max)) / 2));
    margin-right: var(--gutter);
    padding: 4rem 0;
  }

  .hero-ghost-num {
    position: absolute;
    top: -1rem;
    left: -0.25rem;
    font-family: var(--font-mono);
    font-size: clamp(6rem, 14vw, 11rem);
    line-height: 1;
    color: rgba(3, 26, 64, 0.06);
    z-index: -1;
    user-select: none;
  }

  .hero-eyebrow {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-navy);
    margin-bottom: 0.75rem;
  }

  .hero h1 {
    font-size: clamp(3rem, 9vw, 6.5rem);
    font-weight: 700;
    margin-bottom: 1rem;
  }

  .hero-sub {
    font-size: 1.15rem;
    color: var(--color-muted);
    max-width: 480px;
    margin-bottom: 2rem;
  }

  .hero-links {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
  }

  /* ── SECTIONS ─────────────────────────────────────────────── */
  section {
    padding: 5rem 0;
  }

  section:nth-child(even) {
    background: var(--color-surface-alt);
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
  }

  .container h2 {
    font-size: 1.75rem;
    font-weight: 700;
    margin-bottom: 1.5rem;
  }

  .section-sub {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-muted);
    margin-bottom: 1rem;
  }

  .rail-stat {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.04em;
    color: var(--color-muted);
  }

  /* ── ABOUT ────────────────────────────────────────────────── */
  .about-photo {
    display: block;
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    border-radius: var(--radius);
    border: 1px solid var(--color-border);
  }

  .about-caption {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.04em;
    line-height: 1.5;
    color: var(--color-muted);
    margin-top: 0.75rem;
  }

  .about-content p {
    color: var(--color-muted);
    max-width: 640px;
  }

  /* ── PROJECTS ─────────────────────────────────────────────── */
  .projects-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1.5rem;
  }

  .project-rows {
    display: flex;
    flex-direction: column;
  }

  .empty-panel {
    border: 1px dashed var(--color-grey-strong);
    background: var(--color-surface-alt);
    padding: 2.5rem;
    text-align: center;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-muted);
  }

  /* ── CONTACT ──────────────────────────────────────────────── */
  .contact-rows {
    display: flex;
    flex-direction: column;
    max-width: 480px;
  }

  .contact-row {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 0.9rem 0 0.9rem 0.9rem;
    border-bottom: 1px solid var(--color-border);
    border-left: 2px solid transparent;
    transition: border-color 0.15s;
  }

  .contact-row:hover,
  .contact-row:focus-within {
    border-left-color: var(--color-navy);
  }

  .contact-label {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-muted);
    min-width: 90px;
  }

  .contact-row a {
    font-size: 0.95rem;
    text-decoration: none;
    color: var(--color-text);
  }

  .contact-row a:hover { color: var(--color-navy); }

  @media (max-width: 640px) {
    .hero-inner { padding: 3rem 0; }
  }
</style>
