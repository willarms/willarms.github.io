---
// src/pages/projects/[slug].astro
// Individual project detail page — one static page generated per project in
// src/data/projects.ts. Linked from ProjectCard whenever a project has a
// longDescription, video, or highlights.

import BaseLayout from "../../layouts/BaseLayout.astro";
import { allProjects } from "../../data/projects";
import type { GetStaticPaths } from "astro";

// Astro needs to know all possible slugs at build time.
// This runs once and generates one page per project.
export const getStaticPaths = (() => {
  return allProjects.map((project) => ({
    params: { slug: project.slug },
    props:  { project },
  }));
}) satisfies GetStaticPaths;

const { project } = Astro.props;
const {
  title,
  longDescription,
  shortDescription,
  techStack,
  githubUrl,
  demoUrl,
  screenshot,
  video,
  slides,
  highlights,
} = project;

// Turns any bare http(s) URL inside a highlight string into a clickable link.
// Escapes everything else first so the rest of the text can't be interpreted as HTML.
const escapeHtml = (s: string) =>
  s.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");

const linkifyHighlight = (text: string) =>
  escapeHtml(text).replace(
    /(https?:\/\/[^\s<]+)/g,
    (url) => `<a href="${url}" target="_blank" rel="noopener">${url}</a>`
  );
---

<BaseLayout title={`${title} — Will Armsworthy`} description={shortDescription}>
  <article class="project-page">
    <div class="container">
      <div class="page-inner">

        <a href="/#projects" class="back-link">← All projects</a>

        <header class="project-header">
          <h1>{title}</h1>
          <p class="project-subtitle">{shortDescription}</p>

          <ul class="tech-stack">
            {techStack.map((tech) => <li>{tech}</li>)}
          </ul>

          <div class="project-links">
            {githubUrl && (
              <a href={githubUrl} target="_blank" rel="noopener" class="btn-primary">
                View on GitHub →
              </a>
            )}
            {demoUrl && (
              <a href={demoUrl} target="_blank" rel="noopener" class="btn-ghost">
                Live Demo →
              </a>
            )}
            {slides && (
              <a href={`/assets/presentations/${slides}`} download class="btn-ghost">
                Download Slides →
              </a>
            )}
          </div>
        </header>

        {screenshot && (
          <div class="project-screenshot">
            <img src={`/assets/screenshots/${screenshot}`} alt={`${title} screenshot`} />
          </div>
        )}

        {video && (
          <div class="project-video">
            <video controls preload="metadata" playsinline>
              <source src={`/assets/screen-recordings/${video}`} />
            </video>
          </div>
        )}

        {(longDescription || highlights) && (
          <div class="project-body">
            {longDescription && <p>{longDescription}</p>}

            {highlights && highlights.length > 0 && (
              <>
                <h2>Highlights</h2>
                <ul class="highlights">
                  {highlights.map((h) => <li set:html={linkifyHighlight(h)} />)}
                </ul>
              </>
            )}
          </div>
        )}

      </div>
    </div>
  </article>
</BaseLayout>

<style>
  .project-page {
    padding: 4rem 0;
  }

  .page-inner {
    max-width: 720px;
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .back-link {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-muted);
    text-decoration: none;
  }

  .back-link:hover { color: var(--color-navy); }

  .project-header {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .project-header h1 {
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    font-weight: 700;
  }

  .project-subtitle {
    font-size: 1.1rem;
    color: var(--color-muted);
  }

  .project-links {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .project-screenshot,
  .project-video {
    border-radius: var(--radius);
    overflow: hidden;
    border: 1px solid var(--color-border);
  }

  .project-screenshot img,
  .project-video video {
    width: 100%;
    display: block;
  }

  .project-body {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    color: var(--color-muted);
    font-size: 1rem;
    line-height: 1.7;
  }

  .project-body h2 {
    font-size: 1.25rem;
    color: var(--color-text);
  }

  .highlights {
    padding-left: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .highlights a {
    color: var(--color-navy);
  }
</style>
