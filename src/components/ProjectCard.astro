---
// src/components/ProjectCard.astro
// Renders a project in one of two treatments:
//   variant="featured" — image-forward card (Currently Building / Recent Projects)
//   variant="compact"  — text-forward ledger row (Older Projects)

import type { Project } from "../data/projects";

interface Props {
  project: Project;
  variant?: "featured" | "compact";
}

const { project, variant = "featured" } = Astro.props;
const { slug, title, shortDescription, techStack, githubUrl, demoUrl, screenshot, longDescription, video, highlights } = project;

// Only link to the dedicated project page once it actually has extra content to show
const hasDetailPage = Boolean(video || longDescription || (highlights && highlights.length > 0));
---

{variant === "compact" ? (
  <article class="project-row">
    <div class="row-main">
      {hasDetailPage ? (
        <a href={`/projects/${slug}`} class="row-title">{title}</a>
      ) : (
        <span class="row-title">{title}</span>
      )}
      <ul class="tech-stack">
        {techStack.map((tech) => <li>{tech}</li>)}
      </ul>
    </div>
    <div class="row-links">
      {githubUrl && <a href={githubUrl} target="_blank" rel="noopener">GitHub →</a>}
      {demoUrl   && <a href={demoUrl}   target="_blank" rel="noopener">Live Demo →</a>}
    </div>
  </article>
) : (
  <article class="project-card">
    {screenshot ? (
      <div class="card-image">
        <img src={`/assets/screenshots/${screenshot}`} alt={`${title} screenshot`} loading="lazy" />
      </div>
    ) : (
      <div class="card-image" />
    )}

    <div class="card-body">
      <h3>{title}</h3>

      <p class="card-description">{shortDescription}</p>

      <ul class="tech-stack">
        {techStack.map((tech) => <li>{tech}</li>)}
      </ul>

      <div class="card-links">
        {hasDetailPage && <a href={`/projects/${slug}`}>Details →</a>}
        {githubUrl && <a href={githubUrl} target="_blank" rel="noopener">GitHub →</a>}
        {demoUrl   && <a href={demoUrl}   target="_blank" rel="noopener">Live Demo →</a>}
      </div>
    </div>
  </article>
)}

<style>
  /* ── FEATURED CARD ────────────────────────────────────────── */
  .project-card {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    transition: border-color 0.15s ease, background-color 0.15s ease;
  }

  .project-card:hover,
  .project-card:focus-within {
    border-color: var(--color-navy);
    background: var(--color-surface-alt);
  }

  .card-image {
    background: var(--color-surface-alt);
    height: 160px;
    overflow: hidden;
  }

  .card-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .card-body {
    padding: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    flex: 1;
  }

  .card-body h3 {
    font-size: 1rem;
    font-weight: 600;
  }

  .card-description {
    font-size: 0.875rem;
    color: var(--color-muted);
    flex: 1;
  }

  .card-links {
    display: flex;
    gap: 1rem;
    font-size: 0.85rem;
    font-weight: 500;
  }

  .card-links a {
    color: var(--color-navy);
    text-decoration: none;
  }

  .card-links a:hover {
    text-decoration: underline;
  }

  /* ── COMPACT ROW (Older Projects) ────────────────────────── */
  .project-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    padding: 1rem 0;
    border-bottom: 1px solid var(--color-border);
    transition: border-color 0.15s ease;
  }

  .project-row:hover,
  .project-row:focus-within {
    border-color: var(--color-navy);
  }

  .row-main {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    flex-wrap: wrap;
    min-width: 0;
  }

  .row-title {
    font-weight: 600;
    font-size: 0.95rem;
    color: var(--color-text);
    text-decoration: none;
  }

  a.row-title:hover {
    color: var(--color-navy);
    text-decoration: underline;
  }

  .row-links {
    display: flex;
    gap: 1rem;
    font-size: 0.82rem;
    font-weight: 500;
    flex-shrink: 0;
  }

  .row-links a {
    color: var(--color-navy);
    text-decoration: none;
  }

  .row-links a:hover {
    text-decoration: underline;
  }

  @media (max-width: 640px) {
    .project-row {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.75rem;
    }
  }
</style>
