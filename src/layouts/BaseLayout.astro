---
// src/layouts/BaseLayout.astro
// Wraps every page with the nav and global styles.
// To update the nav links, edit the `navLinks` array below.

interface Props {
  title: string;
  description?: string;
}

const { title, description = "Will Armsworthy — Analyst @ insight2profit" } = Astro.props;

const navLinks = [
  { href: "/#home",     label: "Home" },
  { href: "/#about",    label: "About" },
  { href: "/#projects", label: "Projects" },
  { href: "/#contact",  label: "Contact" },
];

const currentPath = Astro.url.pathname;
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <!-- FONT: swap these out in one place to change the font site-wide -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
</head>
<body>
  <header class="site-header">
    <nav>
      <a href="/" class="nav-logo">Will Armsworthy</a>
      <ul>
        {navLinks.map(({ href, label }) => (
          <li>
            <a href={href} class={currentPath === href ? "active" : ""}>{label}</a>
          </li>
        ))}
      </ul>
    </nav>
  </header>

  <main>
    <slot /> <!-- page content goes here -->
  </main>
</body>
</html>

<style is:global>
  /* ── DESIGN TOKENS ─────────────────────────────────────────── */
  /* Palette: navy / grey / white, dominant — small accents allowed sparingly */
  :root {
    --color-navy:         #031a40;
    --color-navy-hover:   #0b2d5c;
    --color-bg:           #ffffff;
    --color-surface:      #ffffff;
    --color-surface-alt:  #eef1f6;
    --color-border:       #dcdddc;
    --color-grey:         #a2a3a2;   /* borders/fills only — fails contrast as text on white */
    --color-grey-strong:  #7d7e7d;
    --color-text:         #031a40;
    --color-muted:        #55606e;
    --color-amber:        #9c5518;   /* sparing accent — FEATURED tag etc. */

    --color-accent:       var(--color-navy);
    --color-accent-hover: var(--color-navy-hover);

    --font-sans: 'Inter', system-ui, sans-serif;
    --font-mono: 'IBM Plex Mono', 'SFMono-Regular', Menlo, Consolas, monospace;

    --radius:        3px;
    --radius-pill:   999px;
    --container-max: 1240px;
    --gutter:        clamp(1.25rem, 4vw, 3rem);
    --rail-width:    220px;
    --rail-gap:      3rem;
    --nav-height:    64px;
  }

  /* ── RESET ──────────────────────────────────────────────────── */
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

  body {
    font-family: var(--font-sans);
    background-color: var(--color-bg);
    color: var(--color-text);
    line-height: 1.6;
  }

  /* ── NAV ────────────────────────────────────────────────────── */
  .site-header {
    position: fixed;
    top: 0; left: 0; right: 0;
    height: var(--nav-height);
    background: var(--color-surface);
    border-bottom: 1px solid var(--color-border);
    z-index: 1000;
  }

  nav {
    max-width: var(--container-max);
    margin: 0 auto;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 var(--gutter);
  }

  .nav-logo {
    font-weight: 700;
    color: var(--color-text);
    text-decoration: none;
    letter-spacing: -0.01em;
  }

  nav ul {
    display: flex;
    list-style: none;
    gap: 2rem;
  }

  nav ul li a {
    font-family: var(--font-mono);
    text-decoration: none;
    color: var(--color-muted);
    font-size: 0.78rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    transition: color 0.15s;
  }

  nav ul li a:hover,
  nav ul li a.active {
    color: var(--color-navy);
  }

  /* ── MAIN ───────────────────────────────────────────────────── */
  main {
    margin-top: var(--nav-height);
  }

  /* ── LAYOUT UTILITIES ───────────────────────────────────────── */
  .container {
    max-width: var(--container-max);
    margin: 0 auto;
    padding: 0 var(--gutter);
  }

  /* Editorial rail + main split — the site's core asymmetric grid pattern */
  .editorial-grid {
    display: grid;
    grid-template-columns: var(--rail-width) 1fr;
    column-gap: var(--rail-gap);
    align-items: start;
  }

  .editorial-grid > .rail {
    border-right: 1px solid var(--color-border);
    padding-right: calc(var(--rail-gap) - 1px);
  }

  .section-index {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-muted);
    margin-bottom: 1rem;
  }

  .section-index em { color: var(--color-grey-strong); font-style: normal; margin: 0 0.15em; }

  @media (max-width: 900px) {
    .editorial-grid { grid-template-columns: 1fr; row-gap: 1.5rem; }
    .editorial-grid > .rail {
      border-right: none;
      border-bottom: 1px solid var(--color-border);
      padding-right: 0;
      padding-bottom: 1.5rem;
    }
  }

  /* ── SHARED UI (buttons, pills) ─────────────────────────────── */
  .btn-primary {
    display: inline-block;
    background: var(--color-navy);
    color: #fff;
    padding: 0.65rem 1.4rem;
    border-radius: var(--radius);
    text-decoration: none;
    font-weight: 600;
    font-size: 0.9rem;
    transition: background-color 0.15s;
  }

  .btn-primary:hover { background: var(--color-navy-hover); color: #fff; }

  .btn-ghost {
    display: inline-block;
    border: 1px solid var(--color-border);
    color: var(--color-text);
    padding: 0.65rem 1.4rem;
    border-radius: var(--radius);
    text-decoration: none;
    font-weight: 600;
    font-size: 0.9rem;
    transition: border-color 0.15s, color 0.15s;
  }

  .btn-ghost:hover { border-color: var(--color-navy); color: var(--color-navy); }

  .tech-stack {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    list-style: none;
  }

  .tech-stack li {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    background: var(--color-surface-alt);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    padding: 0.2rem 0.55rem;
    color: var(--color-muted);
  }

  /* ── UTILITIES ──────────────────────────────────────────────── */
  a { color: var(--color-navy); }
  h1, h2, h3 { line-height: 1.2; letter-spacing: -0.02em; }

  a:focus-visible,
  button:focus-visible,
  .btn-primary:focus-visible,
  .btn-ghost:focus-visible {
    outline: 2px solid var(--color-navy);
    outline-offset: 2px;
  }

  @media (max-width: 640px) {
    nav { padding: 0 1rem; }
    nav ul { gap: 1rem; }
    .nav-logo { display: none; } /* show only links on mobile */
  }
</style>
